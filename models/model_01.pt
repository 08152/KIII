```python
import torch
import torch.nn as nn


class Model01(nn.Module):
    def __init__(self, input_size, hidden_size=128, output_size=64):
        super().__init__()

        self.netz = nn.Sequential(
            nn.Linear(input_size, hidden_size),
            nn.ReLU(),

            nn.Linear(hidden_size, hidden_size),
            nn.ReLU(),

            nn.Linear(hidden_size, output_size)
        )

    def forward(self, x):
        return self.netz(x)


def erstellen(input_size):
    return Model01(input_size=input_size)
```
